{
  "name": "piraten",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "update:outfits": "node scripts/update-outfits.mjs",
    "assets": "python3 scripts/make-assets.py",
    "cap:sync": "npm run build && cap sync ios",
    "test:e2e": "node tests/e2e.mjs",
    "build:html": "tsc -b && vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/pirate-token.html')\""
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
